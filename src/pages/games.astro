---
/* The game shelf — src/data/games.json is the single source of truth.
   Edit the JSON (by hand or by agent); the page just renders it. */
import InterestPage from '../layouts/InterestPage.astro';
import gamesData from '../data/games.json';

const shelves = gamesData.series;
const singles = gamesData.singles;
const totalGames = shelves.reduce((n, s) => n + s.games.length, 0) + singles.length;
---

<InterestPage
  title="Game Shelf — Ijlal Ahmad"
  description={`The games Ijlal Ahmad has played — ${totalGames} titles across ${shelves.length} series.`}
  eyebrow="interests · 03"
  heading="The game shelf"
  sub={`${totalGames} titles, ${shelves.length} series, one very patient hard drive. Open a series to see the whole run.`}
  dark
>
  <div class="crt" aria-hidden="true"></div>

  <div class="shelves">
    {
      shelves.map((s) => (
        <details class="shelf">
          <summary>
            <span class="cart" aria-hidden="true" />
            <span class="sh-name">{s.name}</span>
            <span class="sh-count">×{s.games.length}</span>
          </summary>
          <ul>
            {s.games.map((g) => <li>{g}</li>)}
          </ul>
        </details>
      ))
    }
  </div>

  <h2 class="singles-h">one-offs, all killer</h2>
  <div class="singles">
    {singles.map((g) => <span class="cartridge">{g}</span>)}
  </div>
</InterestPage>

<style>
  .crt{position:fixed;inset:0;pointer-events:none;z-index:1;opacity:.5;
    background:repeating-linear-gradient(transparent 0 3px,rgba(0,0,0,.14) 3px 4px)}
  .shelves{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px;
    align-items:start;position:relative;z-index:2}
  .shelf{background:#12161f;border:1px solid rgba(79,224,176,.2);border-radius:12px;overflow:hidden}
  .shelf summary{display:flex;align-items:center;gap:11px;padding:13px 16px;cursor:pointer;list-style:none}
  .shelf summary::-webkit-details-marker{display:none}
  .shelf summary:hover{background:rgba(79,224,176,.06)}
  .cart{width:22px;height:16px;border-radius:3px 3px 5px 5px;flex:none;
    background:linear-gradient(#4FE0B0,#0E7A5C);box-shadow:inset 0 -4px 0 rgba(0,0,0,.3)}
  .shelf:nth-child(3n) .cart{background:linear-gradient(#F49FB6,#B03A66)}
  .shelf:nth-child(3n+1) .cart{background:linear-gradient(#FFC66E,#C4571F)}
  .sh-name{font-family:var(--font-mono);font-size:13px;font-weight:600;color:var(--washi);flex:1}
  .sh-count{font-family:var(--font-mono);font-size:11px;color:#4FE0B0}
  .shelf ul{list-style:none;padding:2px 16px 12px 49px}
  .shelf li{font-size:12.5px;color:#9BA8C4;padding:4px 0;border-top:1px dashed rgba(155,168,196,.15)}
  .shelf li:first-child{border-top:none}
  .shelf[open]{border-color:rgba(79,224,176,.5)}
  .singles-h{font-family:var(--font-display);font-weight:800;font-size:24px;margin:40px 0 14px;position:relative;z-index:2}
  .singles{display:flex;flex-wrap:wrap;gap:8px;position:relative;z-index:2}
  .cartridge{font-family:var(--font-mono);font-size:12px;color:#CBD2E0;background:#12161f;
    border:1px solid rgba(245,239,226,.16);border-left:4px solid #4FE0B0;border-radius:6px;padding:8px 12px}
  .cartridge:nth-child(3n){border-left-color:#F49FB6}
  .cartridge:nth-child(3n+1){border-left-color:#FFC66E}
</style>
