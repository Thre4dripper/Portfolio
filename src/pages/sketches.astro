---
/* The sketchbook wall. Every image ships three ways:
   1. a ~300-byte blurred placeholder inlined into the HTML (paints instantly),
   2. a ~50KB thumbnail that fades in over it (lazy, async),
   3. a ~450KB full version the lightbox sharpens into (thumb shows meanwhile).
   That's the LQIP "blur-up" ladder — the same trick Medium/Unsplash use. */
import InterestPage from '../layouts/InterestPage.astro';
import sketches from '../data/sketches.json';

const tilt = (i: number) => ((i * 137) % 7) - 3 + (i % 2 ? 0.6 : -0.4);
---

<InterestPage
  title="Sketchbook — Ijlal Ahmad"
  description="Ballpoint pen sketches from Ijlal Ahmad's notebooks — anime characters drawn between deploys."
  eyebrow="interests · 01"
  heading="The sketchbook wall"
  sub="Ballpoint pen, ruled notebook paper, zero undo button. Drawn between deploys — tap any page for the full scan."
  dark
>
  <div class="board">
    {
      sketches.map((s, i) => (
        <button
          class="pinned"
          style={`--tilt:${tilt(i).toFixed(1)}deg`}
          data-full={`/sketches/full/${s.id}.webp`}
          data-lqip={s.lqip}
          data-n={`${String(i + 1).padStart(2, '0')} / ${String(sketches.length).padStart(2, '0')}`}
          aria-label={`Open sketch ${i + 1} of ${sketches.length}`}
        >
          <span class="pin" />
          <span class="tape" />
          <span class="ph" style={`background-image:url('${s.lqip}');aspect-ratio:${s.w}/${s.h}`}>
            <img
              src={`/sketches/thumb/${s.id}.webp`}
              alt={`Ballpoint sketch ${i + 1}`}
              width={s.w}
              height={s.h}
              loading={i < 4 ? 'eager' : 'lazy'}
              decoding="async"
              onload="this.classList.add('ld')"
            />
          </span>
          <span class="cap">№ {String(i + 1).padStart(2, '0')}</span>
        </button>
      ))
    }
  </div>

  <div class="lb" id="lb" hidden>
    <button class="lb-x" id="lb-x" aria-label="close">×</button>
    <figure class="lb-fig">
      <span class="lb-ph" id="lb-ph">
        <img id="lb-img" alt="Sketch, full scan" />
      </span>
      <figcaption id="lb-cap">№ 01</figcaption>
    </figure>
  </div>
</InterestPage>

<style>
  .board{columns:4 240px;column-gap:22px;
    background:
      radial-gradient(rgba(245,239,226,.05) 1px, transparent 1.6px) 0 0/26px 26px,
      linear-gradient(160deg,#141722,#10131d);
    border:1px solid rgba(245,239,226,.12);border-radius:18px;padding:26px}
  .pinned{position:relative;display:block;width:100%;margin:0 0 22px;padding:10px 10px 6px;
    background:#FDFAF2;border:none;border-radius:3px;cursor:zoom-in;break-inside:avoid;
    transform:rotate(var(--tilt,0deg));transition:transform .25s,box-shadow .25s;
    box-shadow:0 14px 30px rgba(0,0,0,.5)}
  .pinned:hover{transform:rotate(0deg) scale(1.03);box-shadow:0 22px 50px rgba(0,0,0,.65);z-index:2}
  .pin{position:absolute;top:-7px;left:50%;transform:translateX(-50%);width:14px;height:14px;
    border-radius:50%;background:radial-gradient(circle at 35% 30%,#F49FB6,#B03A66 65%);
    box-shadow:0 3px 5px rgba(0,0,0,.5);z-index:3}
  .pinned:nth-child(3n) .pin{background:radial-gradient(circle at 35% 30%,#8fd5ff,#2C5AB0 65%)}
  .pinned:nth-child(4n) .pin{background:radial-gradient(circle at 35% 30%,#ffd98f,#C4571F 65%)}
  .tape{position:absolute;top:-9px;right:14px;width:52px;height:18px;transform:rotate(6deg);
    background:rgba(245,239,226,.55);box-shadow:0 1px 3px rgba(0,0,0,.25)}
  .pinned:nth-child(2n) .tape{display:none}
  .ph{display:block;background-size:cover;background-position:center;border-radius:2px;overflow:hidden}
  .ph img{display:block;width:100%;height:auto;opacity:0;transition:opacity .45s ease}
  .ph img.ld{opacity:1}
  .cap{display:block;text-align:center;font-family:var(--font-mono);font-size:10px;
    letter-spacing:.2em;color:#4A4A55;padding:6px 0 4px}

  .lb{position:fixed;inset:0;z-index:60;background:rgba(6,8,16,.92);backdrop-filter:blur(6px);
    display:grid;place-items:center;padding:24px}
  .lb[hidden]{display:none}
  .lb-fig{max-width:min(92vw,760px);max-height:92vh;display:flex;flex-direction:column;gap:10px;margin:0}
  .lb-ph{display:block;background-size:cover;background-position:center;border-radius:6px;
    overflow:hidden;box-shadow:0 30px 90px rgba(0,0,0,.8);max-height:84vh}
  .lb-ph img{display:block;max-width:100%;max-height:84vh;width:auto;height:auto;margin:0 auto;
    filter:blur(14px);transform:scale(1.04);transition:filter .5s ease,transform .5s ease}
  .lb-ph img.sharp{filter:blur(0);transform:none}
  .lb figcaption{text-align:center;font-family:var(--font-mono);font-size:11.5px;
    letter-spacing:.25em;color:var(--moon)}
  .lb-x{position:fixed;top:18px;right:22px;background:none;border:none;color:var(--washi);
    font-size:34px;line-height:1;cursor:pointer;opacity:.8;z-index:61}
  .lb-x:hover{opacity:1}
</style>

<script>
  const lb = document.getElementById('lb')!;
  const ph = document.getElementById('lb-ph')!;
  const img = document.getElementById('lb-img') as HTMLImageElement;
  const cap = document.getElementById('lb-cap')!;

  const close = () => {
    lb.hidden = true;
    img.removeAttribute('src');
  };
  document.getElementById('lb-x')!.addEventListener('click', close);
  lb.addEventListener('click', (e) => {
    if (e.target === lb) close();
  });
  addEventListener('keydown', (e) => e.key === 'Escape' && close());

  document.querySelectorAll<HTMLButtonElement>('.pinned').forEach((btn) => {
    btn.addEventListener('click', () => {
      const thumb = btn.querySelector('img')!.currentSrc || btn.querySelector('img')!.src;
      lb.hidden = false;
      cap.textContent = `№ ${btn.dataset.n}`;
      ph.style.backgroundImage = `url('${btn.dataset.lqip}')`;
      img.classList.remove('sharp');
      /* ladder: cached thumb paints immediately (soft), full swaps in sharp */
      img.src = thumb;
      const full = new Image();
      full.onload = () => {
        img.src = full.src;
        img.classList.add('sharp');
      };
      full.src = btn.dataset.full!;
    });
  });
</script>
