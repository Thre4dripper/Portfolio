---
/* The anime log — ink banners on washi, matching the worldmaker act. */
import InterestPage from '../layouts/InterestPage.astro';
import { ANIME } from '../data/anime';
---

<InterestPage
  title="Anime Log — Ijlal Ahmad"
  description={`The anime that shaped Ijlal Ahmad's taste — ${ANIME.map((a) => a.title).join(', ')} and counting.`}
  eyebrow="interests · 04"
  heading="The anime log"
  sub="The ones that left a mark — some literally, in ballpoint pen, on the sketchbook wall. More get remembered every week."
>
  <div class="banners">
    {
      ANIME.map((a, i) => (
        <article class="banner" style={`--bc:${a.color};--brot:${((i % 3) - 1) * 0.8}deg`}>
          <span class="jp" aria-hidden="true">{a.jp}</span>
          <div class="bn-body">
            <h2>{a.title}</h2>
            <p>{a.note}</p>
            <span class={`st st-${a.status}`}>{a.status}</span>
          </div>
        </article>
      ))
    }
    <article class="banner ghost">
      <span class="jp" aria-hidden="true">次は？</span>
      <div class="bn-body">
        <h2>…and counting</h2>
        <p>the rest of the list is being remembered gradually. it grows.</p>
      </div>
    </article>
  </div>
  <p class="an-note">
    the sketchbook wall has the receipts → <a href="/sketches">see the drawings</a>
  </p>
</InterestPage>

<style>
  .banners{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px}
  .banner{display:flex;gap:0;background:#FFFDF7;border-radius:10px;overflow:hidden;
    transform:rotate(var(--brot,0deg));transition:transform .25s,box-shadow .25s;
    box-shadow:0 1px 0 rgba(27,27,34,.12),0 12px 30px rgba(27,27,34,.14)}
  .banner:hover{transform:rotate(0deg) translateY(-4px);box-shadow:0 18px 44px rgba(27,27,34,.22)}
  .jp{flex:none;writing-mode:vertical-rl;font-weight:700;font-size:17px;letter-spacing:.2em;
    background:var(--bc);color:#FFFDF7;padding:16px 9px;display:flex;align-items:center}
  .banner.ghost{border:1.5px dashed rgba(27,27,34,.3);background:transparent;box-shadow:none}
  .banner.ghost .jp{background:transparent;color:rgba(27,27,34,.4)}
  .bn-body{padding:16px 18px;display:flex;flex-direction:column;gap:7px}
  .bn-body h2{font-family:var(--font-display);font-weight:700;font-size:20px;color:var(--ink)}
  .bn-body p{font-size:13.5px;line-height:1.55;color:var(--ink-soft);flex:1}
  .st{font-family:var(--font-mono);font-size:10px;letter-spacing:.18em;text-transform:uppercase;
    width:fit-content;border-radius:999px;padding:3px 10px;border:1px solid var(--bc);color:var(--bc)}
  .st-watching{background:var(--bc);color:#FFFDF7}
  .an-note{margin-top:34px;font-family:var(--font-mono);font-size:12.5px;color:var(--ink-soft)}
  .an-note a{color:#D8492B}
</style>
