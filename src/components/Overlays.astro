---
/* Fixed-position UI: HUD, chapter rail, skill dock, toast, and the little
   inhabitants of the sky — rocket co-pilot, robot pet, night train, satellite. */
import { RAIL_ITEMS, railLabel, SITE } from '../data/portfolio';
---

<div id="hud-name">
  {SITE.name.toUpperCase()}<small>FULL STACK · WEB / ANDROID</small>
</div>

<button id="skip">Skip to the point →</button>

<nav id="rail" aria-label="Chapters">
  {RAIL_ITEMS.map((it) => <button data-t={railLabel(it)} data-z={it.zCam} aria-label={railLabel(it)} />)}
</nav>

<div id="dock" aria-live="polite">
  <div class="dl" hidden>Skills collected</div>
  <div class="tags"></div>
</div>

<div id="toast" role="status"></div>
<div id="hint2">SCROLL · DRAG · ARROW KEYS</div>

<!-- rocket co-pilot -->
<div id="buddy" aria-hidden="true">
  <div class="bobber">
    <svg viewBox="0 0 90 140">
      <g class="flame">
        <path d="M45 108 C37 119 39 128 45 136 C51 128 53 119 45 108Z" fill="#F2A93B"></path>
        <path d="M45 112 C41 119 42 125 45 130 C48 125 49 119 45 112Z" fill="#FFE08A"></path>
      </g>
      <path d="M28 76 C17 86 14 100 17 108 C26 102 32 94 34 86Z" fill="var(--accent)"></path>
      <path d="M62 76 C73 86 76 100 73 108 C64 102 58 94 56 86Z" fill="var(--accent)"></path>
      <path d="M45 6 C60 24 66 48 66 68 C66 88 58 104 45 108 C32 104 24 88 24 68 C24 48 30 24 45 6Z" fill="#E8E4D8"></path>
      <path d="M45 6 C52 14 57 23 60 33 L30 33 C33 23 38 14 45 6Z" fill="var(--accent)"></path>
      <circle cx="45" cy="52" r="11" fill="#1B1B22"></circle>
      <circle cx="45" cy="52" r="11" fill="none" stroke="var(--accent)" stroke-width="3.5"></circle>
      <circle cx="41" cy="48" r="3" fill="#AEB8C8" opacity=".8"></circle>
      <rect x="31" y="86" width="28" height="5" rx="2.5" fill="var(--accent)" opacity=".7"></rect>
    </svg>
  </div>
</div>
<div id="bubble" role="status"></div>

<!-- robot pet (builder era) -->
<div id="bot" aria-hidden="true">
  <div class="ant"></div>
  <div class="body"><div class="eye"></div></div>
  <div class="wheels"><i></i><i></i></div>
</div>

<!-- night train (grind era) -->
<div id="train" aria-hidden="true">
  <svg viewBox="0 0 260 56">
    <!-- loco -->
    <rect x="6" y="10" width="58" height="30" rx="5" fill="#20232E" stroke="#4A5670" stroke-width="1.4"></rect>
    <rect x="10" y="2" width="18" height="12" rx="3" fill="#20232E" stroke="#4A5670" stroke-width="1.4"></rect>
    <rect x="48" y="16" width="12" height="10" rx="2" fill="#7FB4FF" opacity=".9"></rect>
    <circle cx="20" cy="44" r="7" fill="#141722" stroke="#7FB4FF" stroke-width="1.5"></circle>
    <circle cx="46" cy="44" r="7" fill="#141722" stroke="#7FB4FF" stroke-width="1.5"></circle>
    <!-- cars -->
    <rect x="72" y="14" width="80" height="26" rx="4" fill="#1A1D28" stroke="#4A5670" stroke-width="1.2"></rect>
    <rect x="80" y="20" width="12" height="9" rx="2" fill="#7FB4FF" opacity=".75"></rect>
    <rect x="100" y="20" width="12" height="9" rx="2" fill="#7FB4FF" opacity=".55"></rect>
    <rect x="120" y="20" width="12" height="9" rx="2" fill="#7FB4FF" opacity=".8"></rect>
    <circle cx="86" cy="44" r="6" fill="#141722" stroke="#7FB4FF" stroke-width="1.5"></circle>
    <circle cx="136" cy="44" r="6" fill="#141722" stroke="#7FB4FF" stroke-width="1.5"></circle>
    <rect x="160" y="14" width="80" height="26" rx="4" fill="#1A1D28" stroke="#4A5670" stroke-width="1.2"></rect>
    <rect x="168" y="20" width="12" height="9" rx="2" fill="#7FB4FF" opacity=".6"></rect>
    <rect x="188" y="20" width="12" height="9" rx="2" fill="#7FB4FF" opacity=".85"></rect>
    <rect x="208" y="20" width="12" height="9" rx="2" fill="#7FB4FF" opacity=".5"></rect>
    <circle cx="174" cy="44" r="6" fill="#141722" stroke="#7FB4FF" stroke-width="1.5"></circle>
    <circle cx="224" cy="44" r="6" fill="#141722" stroke="#7FB4FF" stroke-width="1.5"></circle>
  </svg>
</div>

<!-- drifting satellite (final act) -->
<div id="sat-drift" aria-hidden="true">
  <svg viewBox="0 0 90 60">
    <rect x="2" y="22" width="24" height="16" rx="2" fill="#2C5AB0" stroke="#AEB8C8" stroke-width="1.2"></rect>
    <rect x="64" y="22" width="24" height="16" rx="2" fill="#2C5AB0" stroke="#AEB8C8" stroke-width="1.2"></rect>
    <line x1="26" y1="30" x2="34" y2="30" stroke="#AEB8C8" stroke-width="2"></line>
    <line x1="56" y1="30" x2="64" y2="30" stroke="#AEB8C8" stroke-width="2"></line>
    <rect x="34" y="18" width="22" height="24" rx="4" fill="#E8E4D8"></rect>
    <circle cx="45" cy="30" r="5" fill="#F2A93B"></circle>
    <line x1="45" y1="18" x2="45" y2="8" stroke="#AEB8C8" stroke-width="2"></line>
    <circle cx="45" cy="6" r="2.5" fill="#FFC66E"></circle>
  </svg>
</div>
