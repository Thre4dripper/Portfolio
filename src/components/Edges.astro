---
/*
 * Edge scenery: era-themed set dressing that pokes in from the viewport
 * boundaries and parallaxes with the camera. One group per era; the runtime
 * cross-fades groups by era weight and slides each element by its data-p
 * factor as you fly through that era. Purely decorative.
 */
---

<div id="edges" aria-hidden="true">
  <!-- ACT I · the spark — the childhood desk pokes in -->
  <div class="edge-era" data-era="0">
    <div class="poke" data-p="0.05" data-ax="y" style="left:-54px;bottom:8%">
      <svg viewBox="0 0 190 170" width="190">
        <rect x="10" y="10" width="150" height="110" rx="10" fill="#141722" stroke="currentColor" stroke-width="3"/>
        <rect x="24" y="24" width="122" height="82" rx="4" fill="#0B0E1A"/>
        <text x="34" y="52" fill="currentColor" font-family="monospace" font-size="15">C:\&gt;</text>
        <rect class="blinker" x="72" y="40" width="9" height="14" fill="currentColor"/>
        <rect x="60" y="122" width="50" height="12" fill="#141722" stroke="currentColor" stroke-width="2.5"/>
        <rect x="40" y="134" width="90" height="9" rx="3" fill="#141722" stroke="currentColor" stroke-width="2.5"/>
      </svg>
    </div>
    <div class="poke" data-p="-0.07" data-ax="y" style="right:-36px;top:16%;transform:rotate(-14deg)">
      <svg viewBox="0 0 110 110" width="110">
        <rect x="5" y="5" width="100" height="100" rx="8" fill="#141722" stroke="currentColor" stroke-width="3"/>
        <rect x="30" y="5" width="50" height="34" fill="#0B0E1A" stroke="currentColor" stroke-width="2"/>
        <rect x="58" y="10" width="14" height="22" fill="currentColor" opacity=".8"/>
        <rect x="22" y="58" width="66" height="40" rx="3" fill="currentColor" opacity=".25"/>
      </svg>
    </div>
    <div class="poke" data-p="0.09" data-ax="y" style="right:-14px;bottom:22%">
      <svg viewBox="0 0 70 120" width="58">
        <path d="M35 8 q22 26 0 52 q-20 26 0 52" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="2 10" stroke-linecap="round"/>
        <circle cx="35" cy="8" r="5" fill="currentColor"/>
      </svg>
    </div>
  </div>

  <!-- ACT II · the grind — data structures grow from the edges -->
  <div class="edge-era" data-era="1">
    <div class="poke" data-p="0.06" data-ax="y" style="left:-46px;top:24%">
      <svg viewBox="0 0 170 220" width="160">
        <g stroke="currentColor" stroke-width="2.5" fill="none">
          <line x1="20" y1="110" x2="80" y2="50"/><line x1="20" y1="110" x2="80" y2="170"/>
          <line x1="80" y1="50" x2="140" y2="20"/><line x1="80" y1="50" x2="140" y2="84"/>
          <line x1="80" y1="170" x2="140" y2="140"/><line x1="80" y1="170" x2="140" y2="200"/>
        </g>
        <g fill="#0B0E1A" stroke="currentColor" stroke-width="2.5">
          <circle cx="20" cy="110" r="13"/><circle cx="80" cy="50" r="11"/><circle cx="80" cy="170" r="11"/>
          <circle cx="140" cy="20" r="9"/><circle cx="140" cy="84" r="9"/><circle cx="140" cy="140" r="9"/><circle cx="140" cy="200" r="9"/>
        </g>
        <g fill="currentColor" font-family="monospace" font-size="10" text-anchor="middle">
          <text x="20" y="114">8</text><text x="80" y="54">3</text><text x="80" y="174">13</text>
        </g>
      </svg>
    </div>
    <div class="poke jbrace" data-p="-0.08" data-ax="y" style="right:-30px;top:26%">{'}'}</div>
    <div class="poke" data-p="0.045" data-ax="x" style="left:16%;top:-26px">
      <svg viewBox="0 0 260 60" width="250">
        <g fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M10 0 v22 h60 v-22 M70 22 h60 v-22 M130 22 h60 v-22 M190 22 h60 v-22"/>
        </g>
        <g fill="currentColor" font-family="monospace" font-size="11" text-anchor="middle" opacity=".85">
          <text x="40" y="40">O(1)</text><text x="100" y="40">O(n)</text><text x="160" y="40">O(log n)</text><text x="220" y="40">O(n²)</text>
        </g>
      </svg>
    </div>
  </div>

  <!-- ACT III · the builder — circuits and hardware at the borders -->
  <div class="edge-era" data-era="2">
    <div class="poke" data-p="0.055" data-ax="y" style="left:-8px;top:32%">
      <svg viewBox="0 0 150 260" width="130">
        <g fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M0 20 h70 v50 h50"/><path d="M0 90 h40 v70 h80"/><path d="M0 200 h90 v-30 h40"/>
        </g>
        <g fill="currentColor">
          <circle cx="120" cy="70" r="6"/><circle cx="120" cy="160" r="6"/><circle cx="130" cy="170" r="6"/>
          <rect x="60" y="82" width="18" height="18" rx="2" opacity=".8"/>
        </g>
      </svg>
    </div>
    <div class="poke" data-p="-0.06" data-ax="y" style="right:-58px;top:20%;transform:rotate(9deg)">
      <svg viewBox="0 0 130 240" width="120">
        <rect x="8" y="8" width="114" height="224" rx="22" fill="#0E2B26" stroke="currentColor" stroke-width="4"/>
        <rect x="22" y="34" width="86" height="150" rx="6" fill="#0B0E1A"/>
        <g fill="currentColor" opacity=".7">
          <rect x="30" y="46" width="46" height="7" rx="3"/><rect x="30" y="62" width="66" height="7" rx="3"/>
          <rect x="30" y="78" width="34" height="7" rx="3"/>
        </g>
        <circle cx="65" cy="205" r="11" fill="none" stroke="currentColor" stroke-width="3"/>
      </svg>
    </div>
    <div class="poke" data-p="0.08" data-ax="x" style="left:30%;bottom:-20px">
      <svg viewBox="0 0 240 60" width="230">
        <rect x="4" y="14" width="232" height="40" rx="6" fill="#0B0E1A" stroke="currentColor" stroke-width="2.5"/>
        <g fill="currentColor"><circle cx="26" cy="34" r="5"/><circle cx="46" cy="34" r="5" opacity=".5"/></g>
        <g stroke="currentColor" stroke-width="2"><line x1="70" y1="24" x2="70" y2="44"/><line x1="90" y1="24" x2="90" y2="44"/><line x1="110" y1="24" x2="110" y2="44"/></g>
        <text x="130" y="40" fill="currentColor" font-family="monospace" font-size="13">:8080 ▸ up</text>
      </svg>
    </div>
  </div>

  <!-- ACT IV · worldmaker — the castle skyline rises -->
  <div class="edge-era" data-era="3">
    <div class="poke" data-p="0.04" data-ax="y" style="left:-24px;bottom:-14px">
      <svg viewBox="0 0 240 260" width="220">
        <g fill="#141020">
          <rect x="70" y="200" width="100" height="60"/><rect x="80" y="140" width="80" height="56"/>
          <rect x="90" y="86" width="60" height="50"/><rect x="100" y="40" width="40" height="42"/>
        </g>
        <g fill="currentColor" opacity=".9">
          <path d="M50 202 Q120 178 190 202 L176 214 Q120 196 64 214 Z"/>
          <path d="M62 142 Q120 120 178 142 L166 154 Q120 136 74 154 Z"/>
          <path d="M74 88 Q120 68 166 88 L156 100 Q120 84 84 100 Z"/>
          <path d="M86 42 Q120 24 154 42 L146 54 Q120 40 94 54 Z"/>
          <rect x="118" y="8" width="4" height="26"/>
        </g>
        <g fill="#F2A93B" opacity=".85"><rect x="112" y="108" width="7" height="9"/><rect x="126" y="160" width="7" height="9"/><rect x="104" y="218" width="7" height="9"/></g>
      </svg>
    </div>
    <div class="poke" data-p="-0.05" data-ax="x" style="right:-70px;top:12%">
      <svg viewBox="0 0 260 90" width="250">
        <g fill="currentColor" opacity=".35">
          <ellipse cx="70" cy="50" rx="70" ry="20"/><ellipse cx="150" cy="38" rx="60" ry="16"/><ellipse cx="215" cy="56" rx="45" ry="14"/>
        </g>
      </svg>
    </div>
    <div class="poke" data-p="0.075" data-ax="y" style="right:-16px;bottom:26%">
      <svg viewBox="0 0 90 90" width="80">
        <path d="M6 22 Q45 10 84 22" stroke="currentColor" stroke-width="7" fill="none"/>
        <line x1="10" y1="36" x2="80" y2="36" stroke="currentColor" stroke-width="5"/>
        <line x1="22" y1="22" x2="22" y2="86" stroke="currentColor" stroke-width="6"/>
        <line x1="68" y1="22" x2="68" y2="86" stroke="currentColor" stroke-width="6"/>
      </svg>
    </div>
  </div>

  <!-- ACT V · now — deep space at the borders -->
  <div class="edge-era" data-era="4">
    <div class="poke ringworld" data-p="0.03" data-ax="y" style="left:-19vw;top:-24vh"></div>
    <div class="poke" data-p="-0.06" data-ax="y" style="right:-26px;bottom:-16px">
      <svg viewBox="0 0 170 200" width="150">
        <line x1="60" y1="200" x2="60" y2="90" stroke="currentColor" stroke-width="5"/>
        <path d="M60 96 L118 44" stroke="currentColor" stroke-width="4"/>
        <path d="M96 20 A42 42 0 0 1 138 66" fill="none" stroke="currentColor" stroke-width="5"/>
        <circle cx="118" cy="44" r="7" fill="currentColor"/>
        <path class="pulse1" d="M126 18 A52 52 0 0 1 158 56" fill="none" stroke="currentColor" stroke-width="3"/>
        <path class="pulse2" d="M138 4 A70 70 0 0 1 168 46" fill="none" stroke="currentColor" stroke-width="3"/>
        <line x1="30" y1="200" x2="74" y2="150" stroke="currentColor" stroke-width="4"/>
      </svg>
    </div>
    <div class="poke" data-p="0.05" data-ax="x" style="left:20%;top:-18px">
      <svg viewBox="0 0 220 46" width="210">
        <g fill="currentColor">
          <circle cx="16" cy="30" r="4"/><circle cx="70" cy="14" r="2.6"/><circle cx="126" cy="32" r="3.4"/><circle cx="190" cy="12" r="4.4"/>
        </g>
        <g stroke="currentColor" stroke-width="1.4" opacity=".5">
          <line x1="16" y1="30" x2="70" y2="14"/><line x1="70" y1="14" x2="126" y2="32"/><line x1="126" y1="32" x2="190" y2="12"/>
        </g>
      </svg>
    </div>
  </div>
</div>
