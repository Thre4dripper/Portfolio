---
/*
 * The 3D world, server-rendered. Every node in the flight path is real HTML
 * (crawlable, works before JS loads); the camera script only animates them.
 * Horizontal/vertical offsets are emitted as --dx/--dy custom properties in
 * viewport units — the CSS equivalent of the old innerWidth math.
 */
import { TIMELINE, ERAS, NOTES, GATE_CAM, SITE, LINKEDIN_MILESTONES, HACKS, EXPERIENCE } from '../data/portfolio';
import type { BlogPost, GhRepo, GhStory, LeetStats } from '../lib/types';
import github from '../data/github.json';
import sketches from '../data/sketches.json';

interface Props {
  posts: BlogPost[];
  ghStory: GhStory | null;
  leet: LeetStats;
}
const { posts, ghStory, leet } = Astro.props;

/* extra floating elements around the 2016 terminal */
const COMPILE_SATS = [
  { x: '-22%', y: '12%', z: 100, dur: 5, delay: 0.3, html: `<span class="leet-chip sub">turbo c++ · 640×480</span>` },
  { x: '108%', y: '70%', z: 70, dur: 6, delay: 1.0, html: `<svg viewBox="0 0 40 40" width="30"><rect x="3" y="3" width="34" height="34" rx="3" fill="none" stroke="currentColor" stroke-width="2.4"/><rect x="12" y="3" width="16" height="12" fill="currentColor" opacity=".5"/><rect x="9" y="22" width="22" height="12" rx="1.5" fill="currentColor" opacity=".3"/></svg>` },
  { x: '-16%', y: '78%', z: -80, dur: 4, delay: 0.6, html: `<span class="leet-chip sub">// TODO: everything</span>` },
];

/* extra floating grind-era elements around the DSA notebook */
const GRIND_SATS = [
  { x: '-24%', y: '-12%', z: 120, dur: 5, delay: 0.2, html: `<span class="leet-chip">LeetCode · ${leet.total} solved</span>` },
  { x: '106%', y: '-14%', z: 80, dur: 6, delay: 0.9, html: `<span class="leet-chip sub">${leet.easy} easy · ${leet.medium} med · ${leet.hard} hard</span>` },
  { x: '116%', y: '16%', z: -70, dur: 4, delay: 0.5, html: `<svg viewBox="0 0 88 26" width="72"><g fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="13" r="8"/><circle cx="44" cy="13" r="8"/><circle cx="76" cy="13" r="8"/><path d="M20 13 h14 m-5 -4 5 4 -5 4 M52 13 h14 m-5 -4 5 4 -5 4"/></g></svg>` },
  { x: '38%', y: '-20%', z: 90, dur: 5, delay: 1.1, html: `<span class="leet-chip sub">gfg · codeforces · cses</span>` },
];

/* ---------- journey log: subway-map data ---------- */
interface Station {
  yr: string;
  label: string;
  title?: string;
  img?: string;
}
const short = (s: string, n: number) => (s.length > n ? s.slice(0, n - 1) + '…' : s);
const postYear = (p: BlogPost) => `’${p.year.slice(-2)}`;

const ghStations: Station[] = ghStory
  ? [
      { yr: `’${String(ghStory.joinedYear).slice(-2)}`, label: 'joined GitHub' },
      {
        yr: `’${String(ghStory.firstRepo.year).slice(-2)}`,
        label: short(ghStory.firstRepo.name, 15),
        title: `first repo: ${ghStory.firstRepo.name}`,
      },
      ...ghStory.orgs.map((o) => ({ yr: '', label: short(o.login, 14), img: o.avatar_url, title: `org: ${o.login}` })),
      { yr: 'now', label: `${ghStory.publicRepos} repos · ★${ghStory.totalStars}` },
    ]
  : [
      { yr: '’21', label: 'joined GitHub' },
      { yr: 'now', label: 'building in public' },
    ];

const blogStations: Station[] =
  posts.length > 0
    ? [
        { yr: postYear(posts[posts.length - 1]), label: 'first field report', title: posts[posts.length - 1].title },
        ...(posts.length > 2 ? [{ yr: '', label: `${posts.length} reports logged` }] : []),
        { yr: postYear(posts[0]), label: 'latest report', title: posts[0].title },
      ]
    : [{ yr: 'now', label: 'blogs.ijlalahmad.dev' }];

const liStations: Station[] = LINKEDIN_MILESTONES.map((m) => ({ yr: `’${m.yr.slice(-2)}`, label: m.label }));

const JLINES = [
  { name: 'GITHUB', color: '#4FE0B0', y: 74, stations: ghStations },
  { name: 'BLOG', color: '#7FB4FF', y: 164, stations: blogStations },
  { name: 'LINKEDIN', color: '#F49FB6', y: 254, stations: liStations },
];
/* Stagger each line's stations horizontally so labels never stack between lines. */
const stationX = (i: number, n: number, li: number) =>
  n === 1 ? 420 : 140 + li * 44 + (i * (520 - li * 24)) / (n - 1);
/* GitHub labels ride above the line, LinkedIn below, blog alternates. */
const labelAbove = (i: number, li: number) => (li === 0 ? true : li === 2 ? false : i % 2 === 0);

const ASCII_TREE = `        (8)
       /   \\
     (3)   (10)
     / \\      \\
   (1) (6)    (14)   ← my notes still
       / \\    /        look like this
     (4) (7)(13)`;

/* the desk monitor's git pane: the four most recently pushed repos, newest first */
const LANG_COLORS: Record<string, string> = {
  TypeScript: '#3178C6', JavaScript: '#F1E05A', Kotlin: '#A97BFF', 'C++': '#F34B7D',
  HTML: '#E34C26', CSS: '#663399', Python: '#3572A5', Shell: '#89E051', Astro: '#FF5A03',
  Java: '#B07219', C: '#8A8A8A', Go: '#00ADD8', Rust: '#DEA584', Dart: '#00B4AB',
};
const recentRepos = (github.repos as GhRepo[])
  .filter((r) => !r.fork && r.name !== github.user.login)
  .sort((a, b) => +new Date(b.pushed_at) - +new Date(a.pushed_at))
  .slice(0, 4)
  .map((r) => ({
    ...r,
    color: (r.language && LANG_COLORS[r.language]) || '#AEB8C8',
    date: new Date(r.pushed_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }),
  }));
const sketchCover = sketches[0];

/* the other monitor panes: language share across own repos, latest post, current role */
const langCounts = new Map<string, number>();
for (const r of github.repos as GhRepo[]) {
  if (!r.fork && r.language) langCounts.set(r.language, (langCounts.get(r.language) ?? 0) + 1);
}
const langTotal = [...langCounts.values()].reduce((n, c) => n + c, 0) || 1;
const topLangs = [...langCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 4)
  .map(([name, n]) => ({ name, pct: Math.round((n / langTotal) * 100), color: LANG_COLORS[name] ?? '#AEB8C8' }));
const otherPct = Math.max(0, 100 - topLangs.reduce((n, l) => n + l.pct, 0));
const latestPost = posts[0];
/* the same current-role entry the CV leads with */
const nowJob = EXPERIENCE[0];

/* a 15-unit-wide keyboard, row by row: [width, accent?] */
const KBD_ROWS: [number, boolean?][][] = [
  [[1, true], ...Array(12).fill([1]), [2]],
  [[1.5], ...Array(12).fill([1]), [1.5]],
  [[1.75], ...Array(11).fill([1]), [2.25, true]],
  [[2.25], ...Array(10).fill([1]), [2.75]],
  [[1.25], [1.25], [1.25], [6.25], [1.25], [1.25], [1.25], [1.25]],
];

/* Horizontal fan-out is emitted as sign + magnitude so CSS can scale the whole
   layout per breakpoint (--dxk): full on desktop, gentler on tablets where the
   asymmetry is obvious, zero on phones. --dx itself is composed in global.css. */
const offset = (idx: number, item: (typeof TIMELINE)[number]) => {
  if (item.type === 'fact') {
    return {
      sign: idx % 2 ? 1 : -1,
      mag: 'min(27vw, 310px)',
      dy: `${((idx % 3) - 1) * 55 - 20}px`,
    };
  }
  if (item.type === 'block') {
    return { sign: -1, mag: 'min(18vw, 200px)', dy: '-180px' };
  }
  if (item.type === 'ch') {
    return {
      sign: idx % 2 ? -1 : 1,
      mag: 'min(14vw, 170px)',
      dy: `${((idx % 3) - 1) * 24}px`,
    };
  }
  return { sign: 0, mag: '0px', dy: '0px' };
};

const factRotation = (idx: number) => `${(idx % 2 ? 1 : -1) * (2 + (idx % 3))}deg`;

/* ---------- card satellites: era-themed objects floating at real 3D depths ---------- */
const SAT_SLOTS = [
  { x: '-16%', y: '-14%' }, { x: '106%', y: '-10%' }, { x: '112%', y: '58%' },
  { x: '-18%', y: '72%' }, { x: '30%', y: '-22%' }, { x: '-24%', y: '32%' },
  { x: '108%', y: '26%' }, { x: '55%', y: '114%' },
];
const SVG = {
  plane: `<svg viewBox="0 0 32 26" width="30"><path d="M1 12 L31 1 L20 25 L14 16 Z" fill="currentColor" opacity=".9"/><path d="M14 16 L31 1" stroke="#0B0E1A" stroke-width="1.2"/></svg>`,
  chai: `<svg viewBox="0 0 28 27" width="24"><path d="M4 9 h16 v7 a8 8 0 0 1 -16 0 Z" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M20 11 h3 a3.5 3.5 0 0 1 0 7 h-3.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M9 5 q1.5 -2.2 0 -4 M14 5 q1.5 -2.2 0 -4" stroke="currentColor" stroke-width="1.6" fill="none" opacity=".8"/></svg>`,
  tree: `<svg viewBox="0 0 34 30" width="27"><line x1="17" y1="6" x2="8" y2="22" stroke="currentColor" stroke-width="1.8"/><line x1="17" y1="6" x2="26" y2="22" stroke="currentColor" stroke-width="1.8"/><circle cx="17" cy="5" r="4.2" fill="currentColor"/><circle cx="8" cy="23" r="4.2" fill="currentColor"/><circle cx="26" cy="23" r="4.2" fill="currentColor"/></svg>`,
  gear: `<svg viewBox="0 0 30 30" width="26"><circle cx="15" cy="15" r="6.5" fill="none" stroke="currentColor" stroke-width="2.6"/><g stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><line x1="15" y1="1.5" x2="15" y2="6"/><line x1="15" y1="24" x2="15" y2="28.5"/><line x1="1.5" y1="15" x2="6" y2="15"/><line x1="24" y1="15" x2="28.5" y2="15"/><line x1="5.5" y1="5.5" x2="8.7" y2="8.7"/><line x1="21.3" y1="21.3" x2="24.5" y2="24.5"/><line x1="24.5" y1="5.5" x2="21.3" y2="8.7"/><line x1="8.7" y1="21.3" x2="5.5" y2="24.5"/></g></svg>`,
  phone: `<svg viewBox="0 0 20 32" width="17"><rect x="1.5" y="1.5" width="17" height="29" rx="3.5" fill="none" stroke="currentColor" stroke-width="2.4"/><line x1="7" y1="26" x2="13" y2="26" stroke="currentColor" stroke-width="2"/></svg>`,
  planet: `<svg viewBox="0 0 36 24" width="32"><circle cx="18" cy="12" r="7.5" fill="currentColor" opacity=".9"/><ellipse cx="18" cy="12" rx="16" ry="5" fill="none" stroke="currentColor" stroke-width="1.7" opacity=".85"/></svg>`,
  torii: `<svg viewBox="0 0 32 28" width="26"><path d="M2 6 Q16 2 30 6" stroke="currentColor" stroke-width="2.8" fill="none"/><line x1="4" y1="12" x2="28" y2="12" stroke="currentColor" stroke-width="2.2"/><line x1="8" y1="6" x2="8" y2="27" stroke="currentColor" stroke-width="2.6"/><line x1="24" y1="6" x2="24" y2="27" stroke="currentColor" stroke-width="2.6"/></svg>`,
  comet: `<svg viewBox="0 0 36 20" width="32"><circle cx="28" cy="10" r="5" fill="currentColor"/><path d="M24 7 L2 3 M23 10 L4 10 M24 13 L6 17" stroke="currentColor" stroke-width="1.6" opacity=".7"/></svg>`,
};
type Sat = { svg?: string; text?: string };
const SAT_SETS: Sat[][] = [
  [{ svg: SVG.plane }, { svg: SVG.chai }, { text: 'hello();' }],   // the spark
  [{ svg: SVG.tree }, { text: '{ }' }, { text: '</>' }],           // the grind
  [{ svg: SVG.gear }, { svg: SVG.phone }, { text: '$_' }],         // the builder
  [{ svg: SVG.torii }, { svg: SVG.planet }, { text: '∞' }],        // worldmaker
  [{ svg: SVG.comet }, { svg: SVG.planet }, { text: '★' }],        // now
];
const eraOf = (zCam: number) => Math.max(0, GATE_CAM.filter((g) => g <= zCam).length - 1);
const satellites = (idx: number, zCam: number) => {
  const set = SAT_SETS[eraOf(zCam)];
  return [0, 1, 2].map((k) => ({
    ...SAT_SLOTS[(idx * 3 + k) % SAT_SLOTS.length],
    ...set[(idx + k) % set.length],
    z: [-90, 70, 130][k],
    dur: 4 + ((idx + k) % 3),
    delay: (idx % 4) * 0.4 + k * 0.55,
  }));
};
---

<div
  id="stage"
  aria-label="3D journey through Ijlal's life and work. Scroll to travel. A plain-text version is available via the Skip to the point button."
>
  <div id="world">
    {
      TIMELINE.map((item) => {
        const { sign, mag, dy } = offset(item.idx, item);
        const style = `--dxs:${sign};--dxm:${mag};--dy:${dy}`;
        const z = -item.zCam;

        if (item.type === 'intro')
          return (
            <div class="node intro" data-z={z} style={style}>
              <div class="eyebrow">A portfolio you fly through</div>
              <h1>
                IJLAL
                <br />
                <em>AHMAD</em>
              </h1>
              <p>
                Full stack, Android, and AI-platform engineer. This isn't a page — it's a flight path.
                <br />
                Five acts ahead. The sky changes as the story does.
              </p>
              <div class="hint">SCROLL TO FLY ↓</div>
            </div>
          );

        if (item.type === 'gate') {
          const era = ERAS[item.era];
          return (
            <div class="node gate" data-z={z} data-near="1" style={`${style};color:${era.acc}`}>
              <div class="rule" />
              <h2>{era.name}</h2>
              <small>{era.sub}</small>
              <div class="rule" style="margin-top:16px" />
            </div>
          );
        }

        if (item.type === 'fact')
          return (
            <aside class="node fact" data-z={z} style={style}>
              <div class="fin" style={`--rot:${factRotation(item.idx)}`}>
                <div class="pin" />
                <div class="fl">field note</div>
                <p>{NOTES[item.n]}</p>
              </div>
            </aside>
          );

        if (item.type === 'block')
          return (
            <div class="node" data-z={z} style={style}>
              <button id="qblock" aria-label="Secret block. Press for a fun fact.">
                ?
              </button>
            </div>
          );

        if (item.type === 'journeys')
          return (
            <section class="node journeys" data-z={z} data-near="1" style={style} aria-label="Career journey map">
              <div class="bn-eyebrow">THE JOURNEY LOG · THREE LINES, ONE STORY</div>
              <h2>Transit map of a career</h2>
              <svg
                class="jmap"
                viewBox="0 0 780 320"
                role="img"
                aria-label="Timeline of GitHub, blog and LinkedIn milestones as a transit map"
              >
                {JLINES.map((l, li) => (
                  <g class={`jline${l.name === 'BLOG' ? ' jl-blog' : ''}`} style={`--lc:${l.color}`}>
                    <path class="jl-path" d={`M 18 ${l.y + 30} L 50 ${l.y} H 762`} style={`animation-delay:${li * 0.25}s`} />
                    <text class="jl-name" x="20" y={l.y + 44}>{l.name}</text>
                    {l.name === 'BLOG' && <rect class="jl-hit" x="55" y={l.y - 42} width="710" height="90" fill="transparent" />}
                    <g class="jsum">
                      {l.stations.map((s, i) => {
                        const x = stationX(i, l.stations.length, li);
                        const above = labelAbove(i, li);
                        const clipId = `jclip-${li}-${i}`;
                        return (
                          <g class="jstn" style={`--d:${(0.5 + li * 0.25 + i * 0.16).toFixed(2)}s`} transform={`translate(${x.toFixed(0)} ${l.y})`}>
                            <title>{s.title ?? `${s.yr} ${s.label}`.trim()}</title>
                            {s.img ? (
                              <>
                                <clipPath id={clipId}>
                                  <circle r="10" />
                                </clipPath>
                                <circle class="js-c" r="12" />
                                <image href={`${s.img}&s=48`} x="-10" y="-10" width="20" height="20" clip-path={`url(#${clipId})`} />
                              </>
                            ) : (
                              <circle class="js-c" r="7" />
                            )}
                            <text class="js-yr" y={above ? -20 : 30}>{s.yr}</text>
                            <text class="js-lb" y={above ? -34 : 44}>{s.label}</text>
                          </g>
                        );
                      })}
                    </g>
                    {l.name === 'BLOG' && (
                      <g class="jfull" aria-hidden="true">
                        {[...posts].reverse().map((p, i, arr) => {
                          const x = arr.length === 1 ? 420 : 140 + (i * 560) / (arr.length - 1);
                          const above = i % 2 === 0;
                          return (
                            <g class="jstn2" transform={`translate(${x.toFixed(0)} ${l.y})`}>
                              <title>{`${p.title} — ${p.date}`}</title>
                              <circle class="js-c" r="5" />
                              <text class="js-yr" y={above ? -18 : 26}>’{p.year.slice(-2)}</text>
                              <text class="js-lb" y={above ? -31 : 40}>{short(p.title, 17)}</text>
                            </g>
                          );
                        })}
                      </g>
                    )}
                  </g>
                ))}
              </svg>
              <p class="jhint">hover a station for the fine print · hover the blog line for every report</p>
            </section>
          );

        if (item.type === 'blog')
          return (
            <section class="node blognode" data-z={z} data-near="1" style={style} aria-label="Latest blog posts">
              <div class="bn-eyebrow">FIELD REPORTS · FROM THE BLOG</div>
              <h2>Written from the lab</h2>
              {posts.length > 0 ? (
                <div class="postcards">
                  {/* the flight shows the three latest; the journey map's blog
                      line and flat mode carry the full archive */}
                  {posts.slice(0, 3).map((p, i) => (
                    <a class="postcard" href={p.link} target="_blank" rel="noopener" style={`--pr:${i % 2 ? 2.2 : -2.4}deg`}>
                      <div class="pc-top">
                        <span class="pc-date">{p.date}</span>
                        {p.category && <span class="pc-cat">{p.category}</span>}
                      </div>
                      <h3>{p.title}</h3>
                      <span class="pc-read">read the report →</span>
                    </a>
                  ))}
                </div>
              ) : (
                <p class="bn-fallback">Long-form engineering write-ups — homelab, Kubernetes, Android, and whatever broke last week.</p>
              )}
              <a class="bn-all" href={SITE.blog} target="_blank" rel="noopener">
                All posts → blogs.ijlalahmad.dev
              </a>
            </section>
          );

        if (item.type === 'end')
          return (
            <section class="node desk" data-z={z} data-near="1" style={style} aria-label="The desk — contact and links">
              <div class="bn-eyebrow">
                ACT V · NOW · <span id="desk-time">late</span> IN NEW DELHI
              </div>
              <h2>And this is where it all happens.</h2>
              <p class="desk-sub">The desk. Everything on it is clickable.</p>

              <div class="desk-scene">
                <div class="desk-glow" aria-hidden="true" />
                <div class="desk-wall-clock" aria-hidden="true"><b data-clock>--:--</b><span>IST</span></div>

                {/* the lamp — click to flick it */}
                <button class="do do-lamp" id="desk-lamp" aria-label="Toggle the desk lamp" aria-pressed="true">
                  <svg viewBox="0 0 140 220" aria-hidden="true">
                    <defs>
                      <linearGradient id="lamp-beam" gradientUnits="userSpaceOnUse" x1="116" y1="87" x2="250" y2="214">
                        <stop offset="0" stop-color="#FFD98A" stop-opacity=".5" />
                        <stop offset="1" stop-color="#FFD98A" stop-opacity="0" />
                      </linearGradient>
                      <radialGradient id="lamp-pool">
                        <stop offset="0" stop-color="#FFD98A" stop-opacity=".45" />
                        <stop offset="1" stop-color="#FFD98A" stop-opacity="0" />
                      </radialGradient>
                      <radialGradient id="lamp-bulb" cx=".5" cy=".4">
                        <stop offset="0" stop-color="#FFFBEA" />
                        <stop offset=".6" stop-color="#FFE2A8" />
                        <stop offset="1" stop-color="#F2A93B" />
                      </radialGradient>
                      <linearGradient id="lamp-metal" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#5A5366" />
                        <stop offset="1" stop-color="#2A2530" />
                      </linearGradient>
                    </defs>

                    {/* the light it throws: a beam across the desk and a pool where it lands */}
                    <g class="lamp-light">
                      <polygon points="96.5,103.8 136.3,70.4 338,220 146.8,220" fill="url(#lamp-beam)" />
                      <ellipse cx="242" cy="223" rx="110" ry="12" fill="url(#lamp-pool)" />
                    </g>

                    {/* cable trailing off the back of the desk */}
                    <path d="M14 212 C 2 214, -6 206, -14 214" fill="none" stroke="#17141C" stroke-width="2.5" stroke-linecap="round" />

                    {/* weighted base with its switch */}
                    <ellipse cx="40" cy="219" rx="34" ry="3" fill="#0C0A10" opacity=".8" />
                    <path d="M10 218 Q10 202 40 200 Q70 202 70 218 Z" fill="url(#lamp-metal)" />
                    <path d="M16 206 Q40 198 64 206" fill="none" stroke="#6C6478" stroke-width="1.2" opacity=".7" />
                    <rect class="lamp-switch" x="52" y="203" width="8" height="4" rx="1.5" />

                    {/* lower arm: twin rods and a spring, base pivot → elbow */}
                    <g stroke="#5E576B" stroke-width="3.2" stroke-linecap="round">
                      <line x1="37" y1="200" x2="27" y2="112" />
                      <line x1="44" y1="200" x2="34" y2="112" />
                    </g>
                    <path d="M45 182 l-6 -4 l7 -4 l-7 -4 l7 -4 l-7 -4 l7 -4 l-7 -4 l7 -4 l-7 -4 l6 -4" fill="none" stroke="#B3ABBF" stroke-width="1.2" />
                    <circle cx="40" cy="200" r="5" fill="#4A4454" stroke="#1E1B24" stroke-width="1.5" />

                    {/* elbow */}
                    <circle cx="31" cy="111" r="6.5" fill="#4A4454" stroke="#1E1B24" stroke-width="1.5" />
                    <circle cx="31" cy="111" r="2" fill="#8A8296" />

                    {/* upper arm: elbow → head */}
                    <g stroke="#5E576B" stroke-width="3.2" stroke-linecap="round">
                      <line x1="30" y1="107" x2="90" y2="55" />
                      <line x1="34" y1="113" x2="94" y2="61" />
                    </g>
                    <path d="M44 106 l2 -7 l4 6 l2 -7 l4 6 l2 -7 l4 6 l2 -7 l4 6" fill="none" stroke="#B3ABBF" stroke-width="1.2" />

                    {/* the head: a cone shade aimed down and to the right */}
                    <g transform="translate(92 58) rotate(-40)">
