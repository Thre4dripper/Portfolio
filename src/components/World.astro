                <path class="bp-line" style="--bd:.9s" d="M110 75 H144" />
                <g class="bp-box" style="--bd:1.2s">
                  <rect x="144" y="32" width="104" height="86" rx="8" />
                  <text x="196" y="58">agent layer</text>
                  <text x="196" y="76">RAG · workflows</text>
                  <text x="196" y="94">guardrails</text>
                </g>
                <path class="bp-line" style="--bd:1.9s" d="M248 75 H282" />
                <g class="bp-box hero" style="--bd:2.2s">
                  <rect x="282" y="44" width="92" height="62" rx="8" />
                  <text x="328" y="70">AI-native</text>
                  <text x="328" y="86">platform v1</text>
                </g>
                <text class="bp-note" x="190" y="142" style="--bd:2.8s">blueprint · drawn from scratch, 2026</text>
              </svg>
            )}
            {item.set === 'blueprint' && (
              <div class="logo-card out-el" style="--sx:-26%;--sy:32%;--sz:80px" aria-hidden="true">
                <img src="/logos/gus.webp" alt="Global University Systems logo" width="140" loading="lazy" />
                <span>global university systems</span>
              </div>
            )}
            {item.set === 'agent' && (
              <div class="logo-card out-el" style="--sx:126%;--sy:28%;--sz:70px" aria-hidden="true">
                <svg viewBox="0 0 210 64" width="150" role="img" aria-label="Kenverse logo">
                  <circle cx="182" cy="22" r="17" fill="#B0474F" />
                  <circle cx="170" cy="32" r="9" fill="#D2683F" />
                  <circle cx="168" cy="34" r="8" fill="#FFFDF7" />
                  <text x="8" y="46" font-family="Instrument Sans Variable, sans-serif" font-weight="700" font-size="34" letter-spacing="-1" fill="#1B1330">kenverse</text>
                </svg>
                <span>KAI · an AI venture · TurboStart</span>
              </div>
            )}
            {item.set === 'draw' && (
              <>
                <div class="draw-wrap">
                  <canvas id="boardy" width="700" height="260" />
                  <span class="lbl">draw here — go on</span>
                </div>
                <div class="capp out-el" style="--sx:-29%;--sy:28%;--sz:90px;--crot:-3deg">
                  <canvas id="capp-sparkles" width="150" height="100" />
                  <a href="https://github.com/Thre4dripper/Canvas-Sparkles-WebApp" target="_blank" rel="noopener">Canvas-Sparkles ↗</a>
                </div>
                <div class="capp out-el" style="--sx:128%;--sy:62%;--sz:70px;--crot:2.5deg" title="click to drop a ball">
                  <canvas id="capp-gravity" width="150" height="100" />
                  <a href="https://github.com/Thre4dripper/Canvas-Gravity-WebApp" target="_blank" rel="noopener">Canvas-Gravity ↗</a>
                </div>
                <div class="capp capp-list out-el" style="--sx:120%;--sy:2%;--sz:-60px;--crot:2deg">
                  <span>+ particles · particle-text · particle-image</span>
                  <a href="https://github.com/Thre4dripper?tab=repositories&q=Canvas" target="_blank" rel="noopener">the whole canvas era ↗</a>
                </div>
              </>
            )}
            {item.set === 'castle' && (
              <div class="castle" id="castle" title="click to rebuild">
                <span class="glow" />
                <span class="castle-crow" aria-hidden="true">
                  <svg viewBox="0 0 24 14" width="22">
                    <polygon points="2,8 12,5 20,8 12,10" fill="#1B1B22"></polygon>
                    <polygon points="9,7 14,1 13,8" fill="#D8492B"></polygon>
                  </svg>
                </span>
              </div>
            )}
            {item.set === 'rack' && (
              <>
                <div class="rack" title="click a service for live stats">
                  {[
                    { n: 'argocd', d: 'gitops', cpu: 2, mem: '69.8 MB', mw: 34, x: '19/19 apps healthy · 504ms' },
                    { n: 'traefik', d: 'ingress', cpu: 1, mem: '44.6 MB', mw: 24, x: '20 routers · 3 middleware' },
                    { n: 'jellyfin', d: 'media', cpu: 4, mem: '203 MB', mw: 62, x: 'streaming · transcoding? shh' },
                    { n: 'mongodb', d: 'db ×3 · k3s', cpu: 6, mem: '492 MB', mw: 90, x: 'PRIMARY + 2 SECONDARY' },
                  ].map((s, i) => (
                    <div class="svc">
                      <div class="svc-row">
                        <span class="led" style={`animation-delay:${(i * 0.6) % 2.2}s`} />
                        {s.n}
                        <b>{s.d}</b>
                      </div>
                      <div class="svc-detail">
                        <span class="svc-pill">RUNNING</span>
                        <span class="svc-meter">cpu<i style={`--mw:${s.cpu * 6}%`} /><em>{s.cpu}%</em></span>
                        <span class="svc-meter">mem<i style={`--mw:${s.mw}%`} /><em>{s.mem}</em></span>
                        <span class="svc-x">{s.x}</span>
                      </div>
                    </div>
                  ))}
                </div>
                <div class="dsw lan out-el" id="lan" style="--sx:-30%;--sy:44%;--sz:80px">
                  <div class="dsw-title">LAN</div>
                  <svg viewBox="0 0 140 128">
                    <rect x="34" y="6" width="72" height="22" rx="4" fill="none" stroke="currentColor" stroke-width="2" />
                    <g fill="currentColor">
                      <rect x="44" y="20" width="8" height="5" /><rect x="66" y="20" width="8" height="5" /><rect x="88" y="20" width="8" height="5" />
                    </g>
                    <text class="lan-lbl" x="70" y="17">switch</text>
                    <line class="lan-wire" x1="26" y1="28" x2="26" y2="86" /><line class="lan-wire" x1="70" y1="28" x2="70" y2="86" /><line class="lan-wire" x1="114" y1="28" x2="114" y2="86" />
                    <circle class="lan-pk" style="--px:26px" cx="0" cy="0" r="2.6" />
                    <circle class="lan-pk" style="--px:70px;animation-delay:.9s" cx="0" cy="0" r="2.6" />
                    <circle class="lan-pk" style="--px:114px;animation-delay:1.7s" cx="0" cy="0" r="2.6" />
                    <g class="lan-dev" data-dev="pi" tabindex="-1">
                      <rect x="10" y="86" width="32" height="20" rx="3" fill="#1D4A2F" stroke="currentColor" stroke-width="1.6" />
                      <rect x="15" y="91" width="9" height="4" fill="#F2A93B" /><circle cx="34" cy="96" r="3" fill="#0B0E1A" />
                      <text class="lan-lbl" x="26" y="118">pi</text>
                    </g>
                    <g class="lan-dev" data-dev="nas" tabindex="-1">
                      <rect x="56" y="84" width="28" height="24" rx="3" fill="#20232E" stroke="currentColor" stroke-width="1.6" />
                      <line x1="60" y1="91" x2="80" y2="91" stroke="currentColor" stroke-width="1.6" /><line x1="60" y1="98" x2="80" y2="98" stroke="currentColor" stroke-width="1.6" />
                      <text class="lan-lbl" x="70" y="118">nas</text>
                    </g>
                    <g class="lan-dev" data-dev="www" tabindex="-1">
                      <path d="M102 98 a8 8 0 0 1 4 -14 a10 8 0 0 1 19 2 a7 7 0 0 1 -2 12 Z" fill="none" stroke="currentColor" stroke-width="1.8" />
                      <text class="lan-lbl" x="114" y="118">www</text>
                    </g>
                  </svg>
                  <div class="lan-status" id="lan-status">all links up · 1Gbps</div>
                </div>
              </>
            )}
            {item.set !== 'minios' && (
              <>
                <div class="tags">
                  {item.skills.map((s) => (
                    <button class="skill-tag" data-skill={s} title={`repos using ${s} →`}>{s}</button>
                  ))}
                </div>
                {item.link && (
                  <a class="peek" href={item.link[0]} target="_blank" rel="noopener">
                    {item.link[1]}
                  </a>
                )}
              </>
            )}
          </article>
        );
      })
    }
  </div>
</div>
