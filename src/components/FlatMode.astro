---
/*
 * "Boring mode" — the minimal, content-complete CV. Fully server-rendered:
 * crawlers, no-JS visitors and recruiters in a hurry all get everything —
 * experience, education, projects, achievements, writing, skills, contact.
 */
import {
  NOTES, ALL_SKILLS, SITE, EXPERIENCE, EDUCATION, ACHIEVEMENTS, INTERESTS,
} from '../data/portfolio';
import type { BlogPost } from '../lib/blog';

interface Props {
  posts: BlogPost[];
}
const { posts } = Astro.props;

const projects: { yr: string; title: string; body: string; href?: string }[] = [
  { yr: '2023', title: 'Medusa', body: 'AI-proctored examination portal with selective many-to-many WebRTC monitoring. Smart India Hackathon 2023 winner.' },
  { yr: '2023', title: 'Boardy', body: 'Feature-rich drawing and design app in Next.js.', href: 'https://github.com/Thre4dripper/Boardy-WebApp' },
  { yr: '2024', title: 'NodeTs service template + node-server-init', body: 'Production-grade Node + TypeScript service template, scaffolded by one npm command.', href: 'https://github.com/Thre4dripper/NodeTs-Express-Service-Based-Template' },
  { yr: '2025', title: 'Infinity Castle', body: 'Infinite, self-assembling Japanese castle in Three.js — fly through it as a crow, zero art assets.', href: 'https://github.com/Thre4dripper/Infinity-Castle-ThreeJs' },
  { yr: '2025', title: 'Home Server Lab', body: 'Enterprise-grade self-hosted services running 24/7 on Raspberry Pi.', href: 'https://github.com/Thre4dripper/Home-Server-Lab' },
];
---

<div id="flat" role="document">
  <div class="flat-in">
    <div class="note">The plain version — no flying required</div>
    <h1>{SITE.name}</h1>
    <div class="sub">
      Full stack web &amp; Android developer, {SITE.location}. I build tools, worlds, and the servers they run on.
    </div>
    <div class="links">
      <a href={SITE.github}>GitHub</a>
      <a href={SITE.linkedin}>LinkedIn</a>
      <a href={SITE.blog}>Blog</a>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>

    <h3>Experience</h3>
    {
      EXPERIENCE.map((job) => (
        <div class="row">
          <b>{job.when.split(' ')[0].slice(-3)} {job.when.match(/\d{4}/)?.[0]}</b>
          <p>
            <strong>{job.role} · {job.org}</strong> {job.where} · {job.when}
            <span class="bullets">{job.points.map((pt) => <span class="bullet">{pt}</span>)}</span>
          </p>
        </div>
      ))
    }

    <h3>Education</h3>
    {
      EDUCATION.map((ed) => (
        <div class="row">
          <b>{ed.when.match(/\d{4}/)?.[0]}</b>
          <p>
            <strong>{ed.school}</strong> {ed.detail} · {ed.when}
          </p>
        </div>
      ))
    }

    <h3>Projects</h3>
    {
      projects.map((pr) => (
        <div class="row">
          <b>{pr.yr}</b>
          <p>
            <strong>{pr.href ? <a href={pr.href} style="color:#D8492B;text-decoration:none">{pr.title}</a> : pr.title}.</strong> {pr.body}
          </p>
        </div>
      ))
    }

    <h3>Achievements &amp; certifications</h3>
    <div class="notes-list">{ACHIEVEMENTS.map((a) => <span>{a}</span>)}</div>

    {
      posts.length > 0 && (
        <>
          <h3>Writing</h3>
          {posts.map((p) => (
            <div class="row">
              <b>{p.year}</b>
              <p>
                <strong>
                  <a href={p.link} style="color:#D8492B;text-decoration:none">{p.title}</a>
                </strong>{' '}
                {p.category ? `${p.category} · ` : ''}
                {p.date}
              </p>
            </div>
          ))}
          <div class="row">
            <b>ALL</b>
            <p>
              <a href={SITE.blog} style="color:#D8492B">More on the blog →</a>
            </p>
          </div>
        </>
      )
    }

    <h3>Skills</h3>
    <div class="skills">{ALL_SKILLS.map((s) => <span>{s}</span>)}</div>

    <h3>Field notes</h3>
    <div class="notes-list">{NOTES.map((n) => <span>{n}</span>)}</div>

    <h3>Interests</h3>
    <div class="notes-list">{INTERESTS.map((n) => <span>{n}</span>)}</div>

    <h3>Say hello</h3>
    <div class="row">
      <b>NOW</b>
      <p>
        Open to interesting problems. The fastest way to reach me is
        <a href={`mailto:${SITE.email}`} style="color:#D8492B"> email</a> or a GitHub issue on any repo — I actually read those.
      </p>
    </div>
    <p class="rm-note" id="rm-note" hidden>
      You're seeing this version because your system prefers reduced motion. The full experience is one button away if you want it.
    </p>
  </div>
</div>
