# Copy to `.env` (gitignored). Used only at build time, never shipped to the browser.
#
# Optional GitHub personal access token. Unlocks org memberships in the
# Journey Log (they are private to the public API) and raises the build's
# API rate limit. Create one at https://github.com/settings/tokens with
# the `read:org` scope — no repo access needed.
GH_PAT=

# Notion sync (scripts/sync-notion.mjs — run via `pnpm sync:notion` or the
# daily GitHub Action). Create an internal integration at
# https://www.notion.so/my-integrations, copy its secret here, then share the
# database with the integration (Database page → ··· → Connections).
# The database id is the 32-hex-char segment of the database URL:
# notion.so/<workspace>/<THIS_PART>?v=...
NOTION_TOKEN=
NOTION_MOVIES_DB=
