# Copy to `.env` (gitignored). Used only at build time, never shipped to the browser.
#
# Optional GitHub personal access token. Unlocks org memberships in the
# Journey Log (they are private to the public API) and raises the build's
# API rate limit. Create one at https://github.com/settings/tokens with
# the `read:org` scope — no repo access needed.
GITHUB_TOKEN=
